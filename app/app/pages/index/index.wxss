.tittle_bubble{
  display: flex;
  width: 600rpx;
  height: 150rpx;
  border-radius: 30rpx;
  border: cadetblue solid 10rpx;
  padding: 30rpx;
  margin: 30rpx;
  align-items: center;
}
.tittle-normal{
  background-color: #00c853;
}
.tittle-alarm{
  background-color: #ff1744;
}
.Container{
  display: flex;
  flex-direction: column;
  align-items: center;
}
.text1{
  font-size: 48rpx;
  color: #ffffff;
}
.text2{
  font-size: 48rpx;
  color: #ffffff;
  font-weight: bold;
}
.normal{
  width: 60rpx;
  height: 60rpx;
  padding: 15rpx;
}


.bubble_group{
  display: flex;
  flex-wrap: wrap;
}
.fu_bubble{
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 300rpx;
  height: 300rpx;
  background-color: #ffffff;
  border-radius: 30rpx;
  box-shadow: 0rpx 0rpx 30rpx rgba(0, 0,0,0.1);
  margin: 30rpx;
}
.temp_im{
  width: 120rpx;
  height: 120rpx;
  margin: 10rpx;
}
.text1_bubble{
