#define TASK_NETWORK_PRIO   2
/* 【重要】本数组的元素个数必须与 xTaskCreateStatic() 第 3 个参数（栈深度，单位：字）
 * 完全一致。两者不一致时，FreeRTOS 会按参数值初始化栈，从而越界写入数组之后的
 * 静态变量（TCB、任务句柄、队列句柄），表现为启动异常或随机死机。 */
#define TASK_NETWORK_STACK_SIZE   320
static StackType_t Task_Network_Stack[TASK_NETWORK_STACK_SIZE]; // 栈数组
static StaticTask_t Task_Network_TCB;       // 任务控制块
TaskHandle_t Task_Network_Handler;
StaticTask_t	Task_Network_TCB;
void Task_Network(void *pvParameters);

#define TASK_SENSOR_SIZE   256
#define TASK_SENSOR_PRIO   2
TaskHandle_t Task_Sensor_Handler;
/* ===== 响应时间调试：传感器超限 -> 执行器动作（USART1，115200） =====
 * g_resp_start_tick : Task_Sensor 滤波值首次超限时刻（HAL_GetTick，1ms 分辨率）
 * g_resp_alarm_type : 1=火焰 2=燃气 3=复合，0=无
 * g_resp_pending    : 1=已产生报警指令，等待 Task_Control 打印
 * printf 放在三个执行器动作完成之后，串口输出时间不计入 dt。 */
volatile uint32_t g_resp_start_tick = 0;
volatile uint8_t  g_resp_alarm_type = 0;
volatile uint8_t  g_resp_pending = 0;
volatile uint16_t g_resp_fire = 0;
volatile uint16_t g_resp_mq = 0;
volatile uint32_t g_raw_alarm_tick = 0;   /* 原始 ADC 首次超限时刻，仅原始值恢复时清零 */
volatile uint8_t  g_fire_fast = 0;         /* 火焰快速通道：连续5次原始值>2500 */

void Task_Sensor(void *pvParameters);

#define TASK_LOGIC_SIZE   128
#define TASK_LOGIC_PRIO   3
TaskHandle_t Task_Logic_Handler;
void Task_Logic(void *pvParameters);

#define TASK_KEY_SIZE   128
#define TASK_KEY_PRIO   1
TaskHandle_t Task_Key_Handler;
void Task_Key(void *pvParameters);

#define TASK_CONTROL_SIZE   256
#define TASK_CONTROL_PRIO   2
TaskHandle_t Task_Control_Handler;
void Task_Control(void *pvParameters);

#define TASK_DISPLAY_SIZE   128
#define TASK_DISPLAY_PRIO   1
TaskHandle_t Task_Display_Handler;
void Task_Display(void *pvParameters);


static char mqtt_json_buf[256];
/* USER CODE END FunctionPrototypes */

