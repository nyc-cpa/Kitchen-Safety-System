void MX_FREERTOS_Init(void); /* (MISRA C 2004 rule 8.1) */

/**
  * @brief  FreeRTOS initialization
  * @param  None
  * @retval None
  */
void MX_FREERTOS_Init(void) {
  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* USER CODE BEGIN RTOS_MUTEX */
  /* add mutexes, ... */
  /* USER CODE END RTOS_MUTEX */

  /* USER CODE BEGIN RTOS_SEMAPHORES */
  /* add semaphores, ... */
  /* USER CODE END RTOS_SEMAPHORES */

  /* USER CODE BEGIN RTOS_TIMERS */
  /* start timers, add new ones, ... */
  /* USER CODE END RTOS_TIMERS */

  /* USER CODE BEGIN RTOS_QUEUES */
	xQueue_Logic = xQueueCreate(5, sizeof(SensorData_t)); // 这里编译器能识别了！
	xQueue_Display = xQueueCreate(5, sizeof(SensorData_t));
	xQueue_Network = xQueueCreate(5, sizeof(SensorData_t));
	xCmdQueue = xQueueCreate(5, sizeof(ControlData_t));
  /* add queues, ... */
  /* USER CODE END RTOS_QUEUES */

  /* Create the thread(s) */
  /* creation of defaultTask */
//  defaultTaskHandle = osThreadNew(StartDefaultTask, NULL, &defaultTask_attributes);

  /* USER CODE BEGIN RTOS_THREADS */
  /* add threads, ... */
	Task_Network_Handler = xTaskCreateStatic(
													Task_Network,
													"Task_Network",
													TASK_NETWORK_STACK_SIZE,
													NULL,
													TASK_NETWORK_PRIO, 
													Task_Network_Stack, 
													&Task_Network_TCB);


	xTaskCreate(	Task_Sensor,        		// 任务函数的函数名（指针）
								"Task_Sensor",        	// 任务的名字（字符串，调试用）
								TASK_SENSOR_SIZE, 			// 任务栈深度（注意单位：字，不是字节！）
								NULL,        						// 传递给任务的参数（通常填 NULL）
								TASK_SENSOR_PRIO,      // 任务优先级（数值越大优先级越高）
								&Task_Sensor_Handler );// 任务句柄（如果不需要管理任务填 NULL）);
								
	xTaskCreate(	Task_Logic,        		// 任务函数的函数名（指针）
								"Task_Logic",        	// 任务的名字（字符串，调试用）
								TASK_LOGIC_SIZE, 			// 任务栈深度（注意单位：字，不是字节！）
								NULL,        						// 传递给任务的参数（通常填 NULL）
								TASK_LOGIC_PRIO,      // 任务优先级（数值越大优先级越高）
								&Task_Logic_Handler );// 任务句柄（如果不需要管理任务填 NULL）);	

	xTaskCreate(	Task_Key,        		// 任务函数的函数名（指针）
								"Task_Key",        	// 任务的名字（字符串，调试用）
								TASK_KEY_SIZE, 			// 任务栈深度（注意单位：字，不是字节！）
								NULL,        						// 传递给任务的参数（通常填 NULL）
								TASK_KEY_PRIO,      // 任务优先级（数值越大优先级越高）
								&Task_Key_Handler );// 任务句柄（如果不需要管理任务填 NULL）);
	xTaskCreate(	Task_Control,        		// 任务函数的函数名（指针）
								"Task_Control",        	// 任务的名字（字符串，调试用）
								TASK_CONTROL_SIZE, 			// 任务栈深度（注意单位：字，不是字节！）
								NULL,        						// 传递给任务的参数（通常填 NULL）
								TASK_CONTROL_PRIO,      // 任务优先级（数值越大优先级越高）
								&Task_Control_Handler );// 任务句柄（如果不需要管理任务填 NULL）);

	xTaskCreate(	Task_Display,        		// 任务函数的函数名（指针）
								"Task_Display",        	// 任务的名字（字符串，调试用）
								TASK_DISPLAY_SIZE, 			// 任务栈深度（注意单位：字，不是字节！）
								NULL,        						// 传递给任务的参数（通常填 NULL）
								TASK_DISPLAY_PRIO,      // 任务优先级（数值越大优先级越高）
								&Task_Display_Handler );// 任务句柄（如果不需要管理任务填 NULL）);
  /* USER CODE END RTOS_THREADS */

  /* USER CODE BEGIN RTOS_EVENTS */
  /* add events, ... */
  /* USER CODE END RTOS_EVENTS */

}

