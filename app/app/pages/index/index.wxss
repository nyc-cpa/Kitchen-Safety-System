/* ===== 新增卡片：燃气开关(舵机) / 风扇 / 燃气监测 ===== */
.fu_bubble4,
.fu_bubble5,
.fu_bubble6{
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 300rpx;
  height: 340rpx;
  background-color: #ffffff;
  border-radius: 30rpx;
  box-shadow: 0rpx 0rpx 30rpx rgba(0, 0,0,0.1);
  margin: 30rpx;
}

.gas_sw_im,
.fan_im,
.gas_da_im{
  width: 120rpx;
  height: 120rpx;
  margin: 10rpx;
}

.text4_bubble,
.text5_bubble,
.text6_bubble{
  display: flex;
  flex-direction: column;
  text-align: center;
  align-items: center;
}

.gs_text,
.fn_text,
.gd_text{
  font-size: 32rpx;
}

.gs_data,
.fn_data{
  font-size: 32rpx;
}

.gd_data{
  font-size: 48rpx;
}

.gd_hint{
  font-size: 24rpx;
  color: #999999;
}

/* 状态高亮 */
.fire-on{
  color: #ff0000;
}
.gas-on{
  color: #009944;
}
.fan-on{
  color: #1e90ff;
}
.gas-alarm-text{
  color: #ff0000;
}
.gas-alarm-card{
  background-color: #ffe4e1;
  border: 4rpx solid #ff0000;
}